<Window x:Class="P1Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="P1- | Personal Intelligence"
        Width="1320" Height="850" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FF111722" BorderBrush="#FF263243" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,22">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,34">
                        <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentDarkBrush}">
                            <TextBlock Text="P1" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,1,0,0">
                            <TextBlock Text="P1-" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="PERSONAL INTELLIGENCE" FontSize="8" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="#FF718198" Margin="4,0,0,10"/>
                    <Button Content="◈   Overview" HorizontalContentAlignment="Left" Background="#FF1C2B3E" BorderBrush="#FF314D6B" Margin="0,0,0,7" Click="Refresh_Click"/>
                    <Button Content="⌘   Agent" HorizontalContentAlignment="Left" Margin="0,0,0,7" Click="FocusAgent_Click"/>
                    <Button Content="▤   Task runs" HorizontalContentAlignment="Left" Margin="0,0,0,7" Click="TaskHistory_Click"/>
                    <Button Content="◉   Memory &amp; learning" HorizontalContentAlignment="Left" Margin="0,0,0,7" Click="MemoryReview_Click"/>

                    <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold" Foreground="#FF718198" Margin="4,26,0,10"/>
                    <Button Content="◌   Observer" HorizontalContentAlignment="Left" Margin="0,0,0,7" Click="Observer_Click"/>
                    <Button Content="⌑   Permissions" HorizontalContentAlignment="Left" Margin="0,0,0,7" Click="Permissions_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#FF1A2735" CornerRadius="12" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="LOCAL-FIRST MODE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Your models, memory and task history stay on this device unless you explicitly configure remote egress."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="P1- WINDOWS CLIENT" FontSize="9" Foreground="#FF718198"/>
                    <TextBlock Text="Native dashboard · v0.1" FontSize="10" Foreground="#FF718198" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30,24,30,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Your intelligence workspace" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock Text="Local context · controlled actions · inspectable learning"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FF1C2C3B" BorderBrush="#FF31516F" BorderThickness="1" CornerRadius="14" Padding="11,7" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#FF7CC6A2" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="LOCAL WORKSPACE" FontSize="9" FontWeight="Bold" Foreground="#FFB6D8C7"/>
                        </StackPanel>
                    </Border>
                    <Button Content="↻  Refresh" Click="Refresh_Click"/>
                </StackPanel>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="13" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="OBSERVER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="ObserverValue" Text="Unknown" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,0"/>
                        <TextBlock Text="Provider lifecycle" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="13" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="LOCAL EVENTS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="EventCountValue" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,0"/>
                        <TextBlock Text="Stored on this device" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="13" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="TASK RUNS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="TaskCountValue" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,0"/>
                        <TextBlock Text="Recent local workflows" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="13" Padding="16">
                    <StackPanel>
                        <TextBlock Text="EXECUTION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="ExecutionValue" Text="Policy gated" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,0"/>
                        <TextBlock Text="Enable marker, approval and kill switch are independent" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <Border x:Name="AgentCard" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="19" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Start a local agent task" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Describe an outcome. P1- drafts a bounded plan, validates it, saves a task run and advances only until an approval or verification gate is reached."
                                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14"/>
                                <TextBlock Text="GOAL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="GoalInput" Height="82" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="Inspect why browser video playback is stuttering"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="LOCAL MODEL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="ModelInput" Text="qwen2.5:7b-instruct"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="STEP LIMIT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="StepLimitInput" Text="5"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,10,0,8">
                                    <CheckBox x:Name="WithMemoryCheck" Content="Attach local memory (opt-in)"/>
                                    <CheckBox x:Name="SensitiveMemoryCheck" Content="Include sensitive memory"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="RunAgentButton" Content="▶  Run agent task" Style="{StaticResource PrimaryButton}" Click="RunAgent_Click"/>
                                    <TextBlock Text="No action capabilities are granted by this dashboard."
                                               VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="19">
                            <StackPanel>
                                <TextBlock Text="Recent task runs" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Persistent task state and step history from the local SQLite journal."
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,11"/>
                                <TextBox x:Name="TaskHistoryOutput" Height="170" IsReadOnly="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Cascadia Mono" FontSize="10"/>
                                <Button Content="↻  Refresh task history" HorizontalAlignment="Left" Margin="0,10,0,0" Click="TaskHistory_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Border x:Name="ObserverCard" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="19" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Observer controls" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="These controls pause or resume an already-running observer. The dashboard never starts collection automatically."
                                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,13"/>
                                <WrapPanel>
                                    <Button Content="Ⅱ  Pause" Click="PauseObserver_Click" Margin="0,0,8,8"/>
                                    <Button Content="▶  Resume" Click="ResumeObserver_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <TextBlock Text="STATUS DETAIL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,6"/>
                                <TextBox x:Name="ObserverOutput" Height="118" IsReadOnly="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Cascadia Mono" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="19" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Safety controls" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Emergency controls affect capability execution only; they do not stop or delete task history."
                                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                                <Button Content="■  Execution kill switch" Foreground="#FFFFC2C2"
                                        BorderBrush="#FF864C55" Background="#FF3B242B"
                                        HorizontalAlignment="Left" Click="KillExecution_Click"/>
                                <Button Content="Disable execution gate" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Click="DisableExecution_Click"/>
                                <TextBlock Text="The dashboard cannot enable execution or approve proposals."
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,11,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="19">
                            <StackPanel>
                                <TextBlock Text="System output" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="The latest fixed CLI operation and its result."
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                                <TextBox x:Name="OutputBox" Height="174" IsReadOnly="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Cascadia Mono" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="0,13,0,0">
                <TextBlock x:Name="FooterStatus" Text="Ready · Refresh to inspect local P1- status."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Text="ALL COMMANDS ARE LOCAL · NO AUTOMATIC OBSERVATION OR EXECUTION"
                           Foreground="#FF718198" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
